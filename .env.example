# ─── Rug Sentinel Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and fill in your keys

# Birdeye API Key — get yours free at https://bds.birdeye.so
BIRDEYE_API_KEY=your_birdeye_api_key_here

# OpenAI API Key — create at https://platform.openai.com/api-keys
# Without this, the rules engine still works but no AI report is generated
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override default model (default is gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
